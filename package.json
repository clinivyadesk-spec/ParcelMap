{
  "name": "parcelmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/test-units.mjs",
    "verify:stage": "node scripts/verify-stage.mjs",
    "verify:animation": "node scripts/verify-animation.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify": "npm run test && npm run build && npm run verify:stage && npm run verify:animation && npm run verify:editor && npm run verify:export",
    "verify:editor": "node scripts/verify-editor.mjs"
  },
  "dependencies": {
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "maplibre-gl": "^6.2.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
