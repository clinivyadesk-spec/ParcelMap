# Cloudflare Pages headers. This file is copied to the root of dist/ at build
# time and read by Pages when serving.

/assets/*
  # Vite fingerprints every asset filename, so these are safe to cache forever.
  Cache-Control: public, max-age=31536000, immutable

/index.html
  # The entry point must not be cached, or a deploy will not reach browsers
  # that already have it.
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Deliberately NOT set: Cross-Origin-Embedder-Policy. Enabling it would
# require every basemap tile response to carry Cross-Origin-Resource-Policy,
# which OpenFreeMap does not send, and the map would silently stop loading.
# WebCodecs only needs a secure context, which Pages provides over HTTPS.
